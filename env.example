# ─────────────────────────────────────────────────────────────────────
# OpenRAG Environment Configuration
# Copy this file to .env and fill in your values.
# All variables use the OPENRAG_ prefix.
# Nested keys use __ as the separator, e.g. OPENRAG_LLM__MODEL
# ─────────────────────────────────────────────────────────────────────

# ── Namespace & Tenant ───────────────────────────────────────────────
OPENRAG_NAMESPACE=default
OPENRAG_TENANT_ID=default
OPENRAG_WORKING_DIR=./openrag_storage

# ── LLM Provider ────────────────────────────────────────────────────
# Option A: OpenAI (default)
OPENRAG_LLM__PROVIDER=openai
OPENRAG_LLM__MODEL=gpt-4o-mini
OPENRAG_LLM__API_KEY=sk-...
# OPENRAG_LLM__BASE_URL=https://api.openai.com/v1

# Option B: Local (LM Studio / Ollama)
# OPENRAG_LLM__PROVIDER=openai
# OPENRAG_LLM__MODEL=local-model
# OPENRAG_LLM__BASE_URL=http://localhost:1234/v1
# OPENRAG_LLM__API_KEY=not-needed

# ── Embedding Model ──────────────────────────────────────────────────
OPENRAG_EMBEDDING__PROVIDER=openai
OPENRAG_EMBEDDING__MODEL=text-embedding-3-large
OPENRAG_EMBEDDING__DIMENSIONS=3072

# ── Vector Database ──────────────────────────────────────────────────
# Options: in_memory (default, dev) | qdrant | chroma | weaviate | pgvector
OPENRAG_VECTOR_DB__ADAPTER=in_memory
# OPENRAG_VECTOR_DB__URL=http://localhost:6333
# OPENRAG_VECTOR_DB__COLLECTION=openrag_chunks

# ── Graph Database ───────────────────────────────────────────────────
# Options: networkx (default, dev) | neo4j | arangodb
OPENRAG_GRAPH_DB__ENABLED=true
OPENRAG_GRAPH_DB__ADAPTER=networkx
# OPENRAG_GRAPH_DB__URL=bolt://localhost:7687
# OPENRAG_GRAPH_DB__USERNAME=neo4j
# OPENRAG_GRAPH_DB__PASSWORD=password

# ── Document Store ───────────────────────────────────────────────────
# Options: sqlite (default) | postgresql | mongodb
OPENRAG_DOC_STORE__ADAPTER=sqlite
OPENRAG_DOC_STORE__URL=sqlite+aiosqlite:///./openrag_store.db

# ── Parsers ──────────────────────────────────────────────────────────
OPENRAG_PARSER__PDF=pymupdf
OPENRAG_PARSER__DOCX=docling
OPENRAG_PARSER__AUDIO=whisper
OPENRAG_PARSER__CODE=treesitter

# ── Processors ───────────────────────────────────────────────────────
OPENRAG_PROC_IMAGE__ENABLED=true
OPENRAG_PROC_TABLE__ENABLED=true
OPENRAG_PROC_EQUATION__ENABLED=true
OPENRAG_PROC_CODE__ENABLED=true
OPENRAG_PROC_AV__ENABLED=false

# ── API Server ───────────────────────────────────────────────────────
OPENRAG_API__HOST=0.0.0.0
OPENRAG_API__PORT=8000
OPENRAG_API__AUTH_MODE=none
# OPENRAG_API__JWT_SECRET=change-me-in-production

# ── Observability ────────────────────────────────────────────────────
OPENRAG_OBS__TRACING_ENABLED=false
# OPENRAG_OBS__TRACING_ENDPOINT=http://otel-collector:4317
OPENRAG_OBS__METRICS_ENABLED=true
OPENRAG_OBS__AUDIT_LOG_ENABLED=false

# ── Offline / Air-gapped ─────────────────────────────────────────────
# TIKTOKEN_CACHE_DIR=/path/to/local/tiktoken_cache
